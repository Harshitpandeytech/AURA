{
  "name": "aura-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Production API and worker for AURA",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev": "node --watch --experimental-strip-types src/server.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "prisma": "^6.19.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}
